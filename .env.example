# ══════════════════════════════════════════════════════════════════════════════
#  HiveMind — cluster connection template
#
#  Copy this file to .env and fill in the lines marked  ← CHANGE.
#  Delete the preset block you are NOT using.
#
#  cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
#  PRESET A  —  Plain / dev cluster  (no TLS, no Kerberos)
#
#  Minimum changes:
#    1. Set HMS_HOST to your cluster IP or hostname.
#    2. (Optional) Set HS2_HOST if you want EXPLAIN plan analysis.
#    Done — start the server.
# ──────────────────────────────────────────────────────────────────────────────

CLUSTER_PRESET=plain

HMS_HOST=                       # ← CHANGE (required): Hive Metastore host/IP
HMS_PORT=9083
HMS_THRIFT_TIMEOUT_MS=10000

# Optional HiveServer2 — leave HS2_HOST blank to run metadata-only.
HS2_HOST=                       # ← CHANGE (optional): same host as HMS usually
HS2_PORT=10000
HS2_USER=
HS2_DATABASE=default
HS2_QUERY_TIMEOUT_S=60


# ──────────────────────────────────────────────────────────────────────────────
#  PRESET B  —  Cloudera CDH / CDP cluster  (Auto-TLS + AD Kerberos)
#
#  Minimum changes:
#    1. Comment out / delete Preset A above.
#    2. Uncomment the lines below.
#    3. Replace the three ← CHANGE values.
#    4. Run kinit before starting the server:
#         kinit hive -kt /path/to/hive.keytab hive/<fqdn>@<REALM>
#    Done — TLS, Kerberos, HTTP transport, and port 10001 are set automatically.
#
#  Where to find your values:
#    fqdn  — hostname of any cluster node, e.g. ccycloud-1.example.site
#    REALM — from the 'principal=' field in your Beeline/JDBC connection URL
# ──────────────────────────────────────────────────────────────────────────────

# CLUSTER_PRESET=cloudera_kerberos

# HMS_HOST=<fqdn>               # ← CHANGE (required)
# HMS_PORT=9083
# HMS_THRIFT_TIMEOUT_MS=15000

# HMS_USE_TLS=true

# Optional HS2 — set to the same host as HMS_HOST if you want EXPLAIN plans.
# HS2_HOST=<fqdn>               # ← CHANGE (optional)
# HS2_DATABASE=default
# HS2_QUERY_TIMEOUT_S=120

# Copy the principal= value from your JDBC/Beeline URL.
# Setting this automatically enables Kerberos — no other auth flag is needed.
# HIVE_KERBEROS_PRINCIPAL=hive/<fqdn>@<REALM>   # ← CHANGE (required for Kerberos)
